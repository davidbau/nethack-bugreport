         if (sel->bounds.lx > x)
             sel->bounds.lx = x;
         if (sel->bounds.ly > y)
@@ -198,9 +209,9 @@ selection_setpoint(
         if (sel->bounds.hy < y)
             sel->bounds.hy = y;
 
-    /* only set bounds_dirty if changing a point from 1 to 0; if changing
-       a point from 0 to 0, nothing has really changed with the bounds */
