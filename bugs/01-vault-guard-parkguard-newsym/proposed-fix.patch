# Proposed fix for "impossible: newsym attempting screen update for <0,0>" on vault-guard park
#
# Target: NetHack/NetHack@HEAD (NetHack-5.0.0_Release verified).
#
# Root cause (traced via backtrace instrumentation):
#
#   moveloop_core → movemon → iter_mons_safe → movemon_singlemon
#                  → dochugw → dochug → m_move → postmov → newsym(0, 0)
#
# Specifically, postmov at monmove.c:1656 calls newsym(mtmp->mx, mtmp->my)
# for the parked vault guard (mx=0, my=0). Earlier in postmov, line 1514
# has the right guard already:
#
#     } else if (mon_offmap(mtmp)) {
#         return MMOVE_DONE;
#     }
#
# but this check uses the mon_offmap(mon) macro, defined in monst.h:255 as
#
#     #define mon_offmap(mon) ((mon)->mstate != MON_FLOOR)
#
# The parked vault guard has mx=0 BUT mstate=MON_FLOOR (=0). So
# mon_offmap() returns FALSE for it, the check at 1514 doesn't fire,
# and postmov falls through to the newsym(0,0) at line 1656.
#
# parkguard() (vault.c:155) sets the guard's coords to (0,0) via
# place_monster, but never updates mstate. The fix is to mark the
# guard as off-map by OR'ing MON_OFFMAP into mstate. Then the
# existing mon_offmap() infrastructure throughout the codebase
# (monmove.c, mon.c, mhitm.c, muse.c, dogmove.c) all correctly
# skip the parked guard.
#
# Verified: applying this patch and replaying session.json produces
# the "Suddenly, the guard disappears." message correctly but
# eliminates the spurious "newsym: attempting screen update for
# <0,0>" → "Program in disorder!" → "Please report these messages
# to devteam@nethack.org." cascade (3 fewer plines, 3 fewer
# --More-- dismissals required from the player).
#
# The earlier movemon_singlemon check at mon.c:1233 still works
# correctly — it checks (mtmp->mstate & MON_MIGRATING) specifically,
# not the full mstate equality. MON_OFFMAP=0x01 vs MON_MIGRATING=0x04
# don't conflict.

--- a/src/vault.c
+++ b/src/vault.c
@@ -164,11 +164,18 @@ parkguard(struct monst *grd)
     if (m_at(0, 0) != grd)
         place_monster(grd, 0, 0);
     /* [grd->mx,my just got set to 0,0 by place_monster(), so this
        just sets EGD(grd)->ogx,ogy to 0,0 too; is that what we want?] */
     EGD(grd)->ogx = grd->mx;
     EGD(grd)->ogy = grd->my;
+    /* Mark the parked guard as off-map so mon_offmap() returns TRUE
+       for it. Without this, postmov() in monmove.c falls through
+       its mon_offmap early-return at line 1514 and reaches the
+       newsym(mtmp->mx, mtmp->my) call at line 1656, which is
+       newsym(0, 0) — tripping the isok() check and firing the
+       impossible("newsym: attempting screen update for <0,0>")
+       + "Program in disorder!" cascade. */
+    grd->mstate |= MON_OFFMAP;
 }
