# Proposed fix for "impossible: newsym attempting screen update for <0,0>" on vault-guard park
#
# Target: NetHack/NetHack@HEAD (NetHack-5.0.0_Release verified).
#
# Vault.c's parkguard() deliberately parks the guard at coord (0,0) as
# an off-map sentinel — and the inline comment at vault.c:843-851
# (gd_move_cleanup) explains the rationale:
#
#     "We send the guard to never-never land. We set ogx ogy to mx my
#      in order to avoid a check at the top of [gd_move]."
#
# i.e., ogx,ogy are intentionally set to (0,0) so that gd_move()'s
# abs(egrd->ogx - grd->mx) > 1 sanity check (line 930) passes without
# the guard getting treated as a teleported monster. The parkguard
# setup is correct by design.
#
# However, some downstream display pass (vision recalc / movemon
# iteration / postmov redraw) reads the parked guard's coords and
# calls newsym(0, 0). newsym's isok() check rejects column 0, routes
# to impossible(), and fires the user-visible "Program in disorder!"
# cascade.
#
# Fix: have newsym() recognize (0,0) as the documented off-map-
# parked-monster sentinel and return silently. The adjacent existing
# comment "misuse of column 0 is less severe" already acknowledges
# that newsym is reached with x==0; this patch finishes that thought
# by skipping the impossible() call entirely for the documented
# sentinel case.

--- a/src/display.c
+++ b/src/display.c
@@ -926,6 +926,15 @@ newsym(coordxy x, coordxy y)
     if (_suppress_map_output())
         return;
     /* should never happen; same error handling as u_on_newpos() */
     if (!isok(x, y)) {
+        /* (0,0) is the documented off-map parking sentinel used by
+           vault.c parkguard() for the vault guard between guard-action
+           turns (see gd_move_cleanup comment about "never-never land").
+           Some downstream display passes (vision recalc, movemon)
+           reach here with the parked guard's coords; silently no-op
+           for that case so the player doesn't see a spurious
+           "Program in disorder!" cascade. */
+        if (x == 0 && y == 0)
+            return;
         void (*errfunc)(const char *, ...) PRINTF_F_PTR(1, 2);

         errfunc = (x < 0 || y < 0 || x > COLNO - 1 || y > ROWNO - 1) ? panic
